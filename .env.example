# Supabase config is split by environment (Expo auto-loads by NODE_ENV):
#
#   .env.development       → SANDBOX  (used by `expo start`)              [committed]
#   .env.production        → PRODUCTION (used by prod builds / EAS)       [committed]
#   .env.development.local → LOCAL override (optional, see .env.local.example) [gitignored]
#
# Publishable (anon) keys are client keys and safe to commit — RLS protects data.
# This file is just a reference of the variables each env file defines:
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
