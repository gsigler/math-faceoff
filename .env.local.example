# LOCAL Supabase override (optional).
# For developing against the local Supabase stack (`supabase start`).
# Copy this file to `.env.development.local` (gitignored).
#
#   cp .env.local.example .env.development.local
#
# Note: a real device cannot reach 127.0.0.1 — local dev works on the iOS
# simulator / web only. Use your own hosted project for physical-device testing.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Copy the publishable/anon key printed by `supabase start`.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
