{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "EAS_BUILD_NO_EXPO_GO_WARNING": "1" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": { "EAS_BUILD_NO_EXPO_GO_WARNING": "1" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6783423896"
      }
    }
  }
}
